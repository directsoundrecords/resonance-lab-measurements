  "vibrationConditions":{"type":"object","additionalProperties":false,"required":["device","measurement_duration_s","repeat_number","vibration_context"],"properties":{"device":{"$ref":"#/$defs/device"},"measurement_duration_s":{"$ref":"#/$defs/nonNegativeOrMissing"},"repeat_number":{"type":["integer","null"]},"vibration_context":{"$ref":"#/$defs/vibrationContext"}}},
  "range":{"type":"object","additionalProperties":false,"required":["lower","upper"],"properties":{"lower":{"type":"number","minimum":0},"upper":{"type":"number","minimum":0}}},

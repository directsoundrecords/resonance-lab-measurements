  "measuredEnergy":{"type":"object","additionalProperties":false,"required":["rms_mg","energy_percent"],"properties":{"rms_mg":{},"energy_percent":{}}},
  "combinedAnalysis":{"type":"object","additionalProperties":false,"required":["analysis_method_version","predicted_resonance_hz","assessment","resonance_position","coverage","measurement_state","peak_relationship","confidence","summary","detail","recommendations","limitation"],"properties":{"analysis_method_version":{},"predicted_resonance_hz":{},"comparison_window_hz":{"$ref":"#/$defs/comparisonRange"},"measured_energy_near_prediction":{"$ref":"#/$defs/measuredEnergy"},"assessment":{"enum":["not_assessed","low_overlap","moderate_overlap","high_overlap","informational"]},"resonance_position":{"enum":["unavailable","below_preferred","within_preferred","above_preferred"]},"coverage":{"enum":["unavailable","full","partial","outside"]},"measurement_state":{"enum":["no_measurement","unusable_measurement","valid_measurement"]},"peak_relationship":{"enum":["unknown","no_dominant_peaks","peaks_elsewhere","significant_peaks_elsewhere","local_peak_near_prediction","significant_peak_near_prediction","several_features_near_prediction"]},"confidence":{"enum":["sufficient","limited","unavailable"]},"summary":{"type":"string"},"detail":{"type":"string"},"recommendations":{"type":"array","items":{"type":"string"}},"interpretation":{"type":["string","null"]},"limitation":{"type":["string","null"]}}},
  "rpmResults":{"type":"object","additionalProperties":false,"required":["rpm"],"properties":{"rpm":{"$ref":"#/$defs/rpmResult"},"resonance_prediction":{"$ref":"#/$defs/resonancePrediction"},"combined_analysis":{"$ref":"#/$defs/combinedAnalysis"},"stylus_usage_snapshot":{"$ref":"#/$defs/stylusUsage"}}},

  "automaticProvenance":{"type":"object","additionalProperties":false,"required":["app_name","app_version","app_build","platform","device_hardware_identifier","device_display_model","os_name","os_version","timezone","analysis_method_version"],"properties":{"app_name":{"type":"string"},"app_version":{"type":"string"},"app_build":{"type":["string","null"]},"platform":{"type":"string"},"device_hardware_identifier":{"type":"string"},"device_display_model":{"type":["string","null"]},"os_name":{"type":"string"},"os_version":{"type":"string"},"timezone":{"type":"string"},"analysis_method_version":{"type":"string"},"dominant_peak_method_version":{"type":"string"}}},

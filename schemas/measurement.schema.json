  "required": ["schema_version", "measurement_uuid", "public_measurement_id", "setup_uuid", "public_setup_id", "publication_status", "measurement_type", "measurement_datetime", "measurement_datetime_local", "measurement_started_at", "measurement_completed_at", "measurement_timezone", "creator", "publisher", "software", "automatic_provenance", "conditions", "setup_snapshot", "results", "provenance", "files", "license", "measurement_authors", "recommended_citation"],

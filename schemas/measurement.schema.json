  "stylusUsage":{"type":"object","additionalProperties":false,"required":["timing","usage_hours","tracking_source"],"properties":{"timing":{"const":"at_measurement"},"usage_hours":{"$ref":"#/$defs/nonNegativeOrMissing"},"tracking_source":{"type":"string"},"recorded_at":{"oneOf":[{"type":"string","format":"date-time"},{"type":"null"}]}}},
  "setupSnapshot":{"oneOf":[{"type":"object","additionalProperties":false,"required":["state"],"properties":{"state":{"const":"not_available"}}},{"type":"object","additionalProperties":false,"required":["setup_uuid","setup_name","tonearm_manufacturer","tonearm_model","cartridge_manufacturer","cartridge_model"],"properties":{"setup_uuid":{"type":"string","format":"uuid"},"setup_name":{"type":"string"},"turntable_manufacturer":{"type":["string","null"]},"turntable_model":{"type":["string","null"]},"drive_type":{"type":["string","null"]},"suspension_type":{"type":["string","null"]},"tonearm_manufacturer":{"type":"string"},"tonearm_model":{"type":"string"},"tonearm_effective_mass_g":{"type":"number","minimum":0},"cartridge_manufacturer":{"type":"string"},"cartridge_model":{"type":"string"},"cartridge_mass_g":{"type":"number","minimum":0},"mounting_hardware_mass_g":{"type":"number","minimum":0},"vertical_tracking_force_g":{"type":["number","null"],"minimum":0},"anti_skate_setting":{"type":["string","null"]},"alignment_geometry":{"type":["string","null"]},"azimuth_setting":{"type":["string","null"]},"vta_or_sra_setting":{"type":["string","null"]},"platter_mat":{"type":["string","null"]},"clamp_or_record_weight":{"type":["string","null"]},"compliance_used_10hz_um_mn":{"type":"number","minimum":0},"predicted_resonance_hz":{"type":["number","null"],"minimum":0}}}]},

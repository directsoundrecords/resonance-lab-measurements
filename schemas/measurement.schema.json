  "band":{"type":"object","additionalProperties":false,"required":["label","lower_hz","upper_hz","energy_percent","rms_mg"],"properties":{"label":{"enum":["Low","Mid","High"]},"lower_hz":{"type":"number","minimum":0},"upper_hz":{"type":"number","minimum":0},"energy_percent":{"type":"number","minimum":0,"maximum":100,"description":"Band power divided by total 1-40 Hz power, expressed as percent."},"rms_mg":{"type":"number","minimum":0,"description":"Band RMS contribution as defined by the measurement's declared Vibration analysis method version."}}},
  "peak":{"type":"object","additionalProperties":false,"required":["frequency_hz","amplitude_mg"],"properties":{"frequency_hz":{"type":"number","minimum":0},"amplitude_mg":{"type":"number","minimum":0},"classification":{"type":"string"}}},
  "vibrationResult":{"type":"object","additionalProperties":false,"required":["capture_rms_mg","capture_peak_mg","test_duration_s","analysis_range_hz","bands","dominant_peaks","distinct_peak_detected","series_file","spectrum_file","analysis_method_version","dominant_peak_method_version"],"properties":{"capture_rms_mg":{"type":"number"},"capture_peak_mg":{"type":"number"},"test_duration_s":{"type":"number"},"analysis_range_hz":{"$ref":"#/$defs/range"},"bands":{"type":"array","minItems":3,"maxItems":3,"prefixItems":[{"allOf":[{"$ref":"#/$defs/band"},{"properties":{"label":{"const":"Low"},"lower_hz":{"const":1},"upper_hz":{"const":8}}}]},{"allOf":[{"$ref":"#/$defs/band"},{"properties":{"label":{"const":"Mid"},"lower_hz":{"const":8},"upper_hz":{"const":20}}}]},{"allOf":[{"$ref":"#/$defs/band"},{"properties":{"label":{"const":"High"},"lower_hz":{"const":20},"upper_hz":{"const":40}}}]}],"items":false},"dominant_peaks":{"type":"array","maxItems":5,"description":"Strongest descriptive local maxima, independent of significance classification.","items":{"$ref":"#/$defs/peak"}},"distinct_peak_detected":{"allOf":[{"$ref":"#/$defs/booleanOrMissing"}],"description":"Stored legacy-compatible distinct-peak Boolean for measurement evidence only; Combined Analysis 2.0 applies its separate versioned nearby-feature classifier."},"series_file":{"type":"string"},"spectrum_file":{"type":"string"},"analysis_method_version":{"type":"string"},"dominant_peak_method_version":{"type":"string"},"source_measurement_uuid":{},"source_measurement_timestamp_utc":{},"package_conditions_apply":{},"notes":{}}},

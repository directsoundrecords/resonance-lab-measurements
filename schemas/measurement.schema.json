    "attribution_mode": {"enum": ["name", "name_and_affiliation", "anonymous"]},
    "orcid": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{4}-[0-9]{4}-[0-9]{3}[0-9X]$"},"role":{"type":"string"},"location_label":{"type":["string","null"]},"website":{"type":["string","null"]},"source_measurement_uuid":{"type":["string","null"]}

    "submitter": {"oneOf":[{"$ref":"#/$defs/submitter"},{"type":"null"}]}, "publication_consent": {"oneOf":[{"$ref":"#/$defs/consent"},{"type":"null"}]},
    "recommended_citation": {"type": "string"}, "publisher": {"$ref":"#/$defs/publisher"}, "software": {"$ref":"#/$defs/software"}, "automatic_provenance": {"$ref":"#/$defs/automaticProvenance"},
    "conditions": {}, "setup_snapshot": {"$ref":"#/$defs/setupSnapshot"}, "results": {},
    "provenance": {"$ref":"#/$defs/provenance"}, "files":{"$ref":"#/$defs/files"}, "license": {"const": "CC-BY-4.0"},
    "record_version":{"type":"string"},"title":{"type":"string"},"slug":{"type":["string","null"]},"language":{"type":"string"},"date_published":{"oneOf":[{"type":"string","format":"date-time"},{"type":"null"}]},"source_measurement_uuids":{"type":"array"},"measurement_scope":{"type":"array"},"related_applications":{"type":"array"},"related_measurements":{"type":"array"},"interpretation":{"type":"object"},"keywords":{"type":"array","items":{"type":"string"}}

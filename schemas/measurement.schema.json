  "rpmConditions":{"type":"object","additionalProperties":false,"required":["device","measurement_duration_s","repeat_number","rpm_test_state"],"properties":{"device":{"$ref":"#/$defs/device"},"measurement_duration_s":{"$ref":"#/$defs/nonNegativeOrMissing"},"repeat_number":{"type":["integer","null"]},"rpm_test_state":{"$ref":"#/$defs/rpmState"}}},
